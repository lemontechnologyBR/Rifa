# ============================================================
# .env — VouRifar PRODUÇÃO (vourifar.com.br)
# Copie para .env na VPS: cp .env.production.example .env
# ============================================================

# Servidor
PORT=3000
NODE_ENV=production

# Sessão — gere com: openssl rand -hex 32
SESSION_SECRET=ALTERE_PARA_UMA_CHAVE_ALEATORIA_LONGA_32_CHARS

# Webhook de pagamento
WEBHOOK_SECRET=ALTERE_PARA_UM_SEGREDO_PARA_WEBHOOK

# URL pública (sem barra final)
APP_URL=https://vourifar.com.br

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Adicione no Google Console como URI autorizado:
# https://vourifar.com.br/auth/google/organizador/callback

# Woovi (OpenPix) — PIX da plataforma (obrigatório em produção)
WOOVI_ENABLED=true
WOOVI_APP_ID=
# WOOVI_API_BASE=https://api.woovi.com/api/v1

# E-mail SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@vourifar.com.br
SMTP_PASS=

# Seed — NUNCA true em produção com banco já populado
# (cria super admin admin/admin123)
RUN_SEED=false

# Chatwoot (suporte) — token do Website Inbox em https://chat.vourifar.com.br
CHATWOOT_BASE_URL=https://chat.vourifar.com.br
CHATWOOT_WEBSITE_TOKEN=
