<%- include('../partials/header') %>

<style>
/* ═══════════════════════════════════════════════
   DETALHE RIFA — tema claro por padrão / dark via .dark
═══════════════════════════════════════════════ */
.imp-detail { min-height: 100vh; }

.imp-card-dark {
  background: var(--imp-panel);
  border: 1px solid var(--imp-panel-border);
  border-radius: 14px;
  overflow: hidden;
}

.imp-progress-wrap {
  background: var(--imp-progress-track);
  border-radius: 9999px;
  height: 12px;
  overflow: hidden;
  position: relative;
  box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.08);
}
.dark .imp-progress-wrap {
  box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.35);
}
.imp-progress-bar {
  height: 100%;
  border-radius: 9999px;
  background: linear-gradient(90deg, var(--brand-from), var(--brand-to), var(--brand-from));
  background-size: 200% 100%;
  transition: width .7s cubic-bezier(.22,1,.36,1);
  box-shadow: 0 0 12px color-mix(in srgb, var(--brand-from) 55%, transparent);
  animation: imp-progress-shine 2.8s linear infinite;
  position: relative;
}
@keyframes imp-progress-shine {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}
.imp-progress-card {
  background: var(--imp-panel);
  border: 1px solid var(--imp-panel-border);
  border-radius: 14px;
  padding: 14px 16px;
  margin-top: 10px;
  margin-bottom: 10px;
  position: relative;
  overflow: hidden;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
}
.dark .imp-progress-card {
  background: linear-gradient(165deg, #1e1e36 0%, #1a1a2e 100%);
  border-color: rgba(255,255,255,.08);
  box-shadow: none;
}
.imp-progress-card::before {
  content: '';
  position: absolute;
  inset: 0 auto auto 0;
  height: 2px;
  width: 100%;
  background: linear-gradient(90deg, transparent, var(--brand-from), var(--brand-to), transparent);
  opacity: .7;
}

.imp-stepper-btn {
  width: 44px; height: 44px; border-radius: 10px;
  background: var(--imp-input-bg);
  border: 1px solid var(--imp-input-border);
  color: var(--imp-text);
  font-size: 22px; font-weight: 700; cursor: pointer;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.imp-stepper-btn:hover {
  background: color-mix(in srgb, var(--brand-from) 10%, var(--imp-input-bg));
  border-color: color-mix(in srgb, var(--brand-from) 35%, var(--imp-input-border));
}

.imp-stepper-input {
  width: 90px; text-align: center; font-size: 22px; font-weight: 900;
  background: var(--imp-input-bg);
  border: 1px solid var(--imp-input-border);
  border-radius: 10px;
  color: var(--imp-text);
  padding: 8px;
}

.imp-btn-green {
  background: var(--brand-from); color: #000; font-weight: 800; border-radius: 10px;
  padding: 12px 16px; font-size: 14px; line-height: 1.25; border: none; cursor: pointer;
  display: flex; align-items: center; justify-content: center; gap: 8px;
  width: 100%; min-height: 46px; max-height: none;
  transition: background .15s, transform .15s;
}
.imp-btn-green svg,
.imp-btn-green [data-lucide],
.imp-btn-green .lucide {
  width: 1.15rem !important;
  height: 1.15rem !important;
  flex-shrink: 0;
}
.imp-btn-green:hover { background: var(--brand-to); transform: translateY(-1px); }
.imp-btn-green:disabled { background: #e2e8f0; color: #94a3b8; cursor: not-allowed; transform: none; }
.dark .imp-btn-green:disabled { background: #374151; color: #6b7280; }

.imp-accordion-trigger {
  width: 100%;
  background: var(--imp-panel);
  border: 1px solid var(--imp-panel-border);
  border-radius: 12px; padding: 14px 18px; display: flex; align-items: center;
  justify-content: space-between; cursor: pointer;
  color: var(--imp-text);
  font-weight: 700;
  font-size: 14px; transition: border-radius .15s, background .15s;
}
.imp-accordion-trigger:hover {
  background: color-mix(in srgb, var(--brand-from) 6%, var(--imp-panel));
}
.imp-accordion-trigger.is-open {
  border-radius: 12px 12px 0 0;
  border-bottom-color: transparent;
}
.imp-accordion-trigger .imp-acc-chevron {
  transition: transform .2s ease;
  flex-shrink: 0;
  color: var(--imp-text-muted);
}
.imp-accordion-trigger.is-open .imp-acc-chevron {
  transform: rotate(180deg);
}
.imp-accordion-panel {
  display: none;
  background: var(--imp-panel);
  border: 1px solid var(--imp-panel-border);
  border-top: none;
  border-radius: 0 0 12px 12px;
  padding: 16px;
}
.imp-accordion-panel.is-open { display: block; }

@keyframes imp-slide-up { from{opacity:0;transform:translateY(16px)} to{opacity:1;transform:translateY(0)} }
.imp-fade { animation: imp-slide-up .4s ease forwards; }

.imp-premios {
  background: var(--imp-panel);
  border: 1px solid var(--imp-panel-border);
  border-radius: 14px;
  padding: 16px;
  margin-bottom: 10px;
  position: relative;
  overflow: hidden;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
}
.dark .imp-premios {
  background: linear-gradient(165deg, #1e1e36 0%, #1a1a2e 55%, #161628 100%);
  border-color: rgba(255,255,255,.08);
  box-shadow: none;
}
.imp-premios::before {
  content: '';
  position: absolute;
  inset: 0 0 auto 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--brand-from), var(--brand-to), transparent);
  opacity: .85;
}
.imp-premio-row {
  display: flex; align-items: center; gap: 12px;
  padding: 12px 12px;
  border-radius: 12px;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  transition: border-color .15s, background .15s, transform .15s;
}
.dark .imp-premio-row {
  background: rgba(255,255,255,.03);
  border-color: rgba(255,255,255,.06);
}
.imp-premio-row + .imp-premio-row { margin-top: 8px; }
.imp-premio-row:hover {
  background: #f1f5f9;
  border-color: #cbd5e1;
}
.dark .imp-premio-row:hover {
  background: rgba(255,255,255,.05);
  border-color: rgba(255,255,255,.1);
}
.imp-premio-row.is-gold {
  background: linear-gradient(135deg, rgba(251,191,36,.14), rgba(245,158,11,.05));
  border-color: rgba(251,191,36,.4);
  box-shadow: 0 0 0 1px rgba(251,191,36,.08), 0 8px 24px rgba(251,191,36,.06);
}
.imp-premio-row.is-silver {
  background: linear-gradient(135deg, rgba(148,163,184,.12), rgba(100,116,139,.04));
  border-color: rgba(148,163,184,.32);
}
.imp-premio-row.is-bronze {
  background: linear-gradient(135deg, rgba(217,119,6,.12), rgba(180,83,9,.04));
  border-color: rgba(217,119,6,.32);
}
.imp-premio-medal {
  width: 44px; height: 44px; border-radius: 50%;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  flex-shrink: 0; font-weight: 900; line-height: 1;
  border: 2px solid transparent;
}
.imp-premio-medal .rank { font-size: 13px; letter-spacing: -.02em; }
.imp-premio-medal .tag { font-size: 8px; font-weight: 800; text-transform: uppercase; opacity: .85; margin-top: 1px; letter-spacing: .02em; }
.imp-premio-medal.gold {
  background: linear-gradient(145deg, #fde68a, #f59e0b);
  color: #78350f;
  border-color: #fbbf24;
  box-shadow: 0 4px 14px rgba(245,158,11,.35);
}
.imp-premio-medal.silver {
  background: linear-gradient(145deg, #e2e8f0, #94a3b8);
  color: #1e293b;
  border-color: #cbd5e1;
  box-shadow: 0 4px 12px rgba(148,163,184,.25);
}
.imp-premio-medal.bronze {
  background: linear-gradient(145deg, #fdba74, #c2410c);
  color: #431407;
  border-color: #fb923c;
  box-shadow: 0 4px 12px rgba(194,65,12,.28);
}
.imp-premio-medal.unico {
  background: linear-gradient(145deg, color-mix(in srgb, var(--brand-from) 90%, white), var(--brand-to));
  color: #000;
  border-color: var(--brand-from);
  box-shadow: 0 4px 14px color-mix(in srgb, var(--brand-from) 35%, transparent);
}
.imp-premio-body { min-width: 0; flex: 1; }
.imp-premio-nome {
  font-size: 15px; font-weight: 800; color: var(--imp-text); margin: 0; line-height: 1.3;
  word-break: break-word;
}
.imp-premio-row.is-gold .imp-premio-nome { font-size: 16px; }
.imp-premio-desc { font-size: 12px; color: var(--imp-text-muted); margin: 4px 0 0; line-height: 1.4; }

.imp-countdown-cell {
  background: var(--imp-input-bg);
  border: 1px solid var(--imp-input-border);
  border-radius: 8px;
  padding: 6px 8px;
  text-align: center;
  min-width: 42px;
}
.imp-countdown-label {
  font-size: 9px;
  color: var(--imp-text-muted);
  text-transform: uppercase;
}

.imp-sticky-buy {
  background: rgba(255, 255, 255, 0.97);
  border-top: 1px solid var(--imp-panel-border);
  box-shadow: 0 -8px 24px rgba(15, 23, 42, 0.08);
}
.dark .imp-sticky-buy {
  background: rgba(18, 18, 31, 0.97);
  border-top-color: rgba(255, 255, 255, 0.08);
  box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.35);
}

.imp-modal-sheet {
  background: var(--imp-panel) !important;
  border: 1px solid var(--imp-panel-border) !important;
  color: var(--imp-text) !important;
}
.imp-modal-head {
  border-bottom: 1px solid var(--imp-panel-border);
  background: var(--imp-panel);
}
.imp-soft-box {
  background: color-mix(in srgb, var(--imp-text) 3%, var(--imp-panel));
  border: 1px solid var(--imp-panel-border);
  border-radius: 10px;
}
.imp-pkg-price-line {
  font-size: 11px;
  font-weight: 700;
  margin-top: 2px;
  color: var(--imp-text);
}

/* Grade de Números */
.grade-num-btn {
  -webkit-tap-highlight-color: transparent;
  user-select: none;
  transition: background .12s, transform .1s, box-shadow .1s, color .12s, border-color .12s;
  font-size: 13px; font-weight: 800;
  border-radius: 8px; border: 2px solid transparent;
  padding: 10px 2px; cursor: pointer;
  background: #e2e8f0; color: #64748b;
}
.dark .grade-num-btn {
  background: #2d3748; color: #9ca3af;
}
.grade-num-btn.disponivel {
  background: #e2e8f0; color: #64748b; border-color: transparent;
}
.dark .grade-num-btn.disponivel {
  background: #2d3748; color: #9ca3af;
}
.grade-num-btn.disponivel:hover {
  background: #cbd5e1; color: #0f172a; border-color: #94a3b8;
}
.dark .grade-num-btn.disponivel:hover {
  background: #374151; color: #fff; border-color: rgba(255,255,255,.2);
}
.grade-num-btn.reservado {
  background: rgba(251,191,36,.25) !important; color: #b45309 !important;
  border-color: rgba(251,191,36,.55) !important; cursor: not-allowed;
  opacity: 1;
}
.dark .grade-num-btn.reservado {
  color: #fbbf24 !important;
}
.grade-num-btn.vendido {
  background: color-mix(in srgb, var(--brand-from) 25%, transparent) !important; color: var(--brand-from) !important;
  border-color: color-mix(in srgb, var(--brand-from) 55%, transparent) !important; cursor: not-allowed;
  opacity: 1;
}
.grade-num-btn.selecionado {
  background: var(--brand-to) !important;
  color: #fff !important;
  border-color: color-mix(in srgb, var(--brand-from) 65%, white) !important;
  transform: scale(1.12);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand-from) 35%, transparent), 0 4px 12px color-mix(in srgb, var(--brand-from) 40%, transparent);
  font-size: 14px;
  z-index: 1;
  position: relative;
}
.grade-num-btn:disabled { cursor: not-allowed; pointer-events: none; }

.grade-legenda { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-bottom: 12px; }
.grade-legenda-item { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; color: var(--imp-text-muted); font-weight: 600; }
.grade-legenda-dot { width: 14px; height: 14px; border-radius: 4px; border: 2px solid transparent; flex-shrink: 0; }
.grade-legenda-dot.livre { background: #e2e8f0; border-color: #cbd5e1; }
.dark .grade-legenda-dot.livre { background: #2d3748; border-color: rgba(255,255,255,.15); }
.grade-legenda-dot.reservado { background: rgba(251,191,36,.25); border-color: rgba(251,191,36,.55); }
.grade-legenda-dot.pago { background: color-mix(in srgb, var(--brand-from) 25%, transparent); border-color: color-mix(in srgb, var(--brand-from) 55%, transparent); }
.grade-legenda-dot.selecionado { background: var(--brand-to); border-color: color-mix(in srgb, var(--brand-from) 65%, white); }
.imp-hero-img {
  position: relative;
  overflow: hidden;
  border-radius: 14px;
}
.imp-hero-img.imp-card-dark {
  /* hero com foto: fundo neutro; caption continua legível pelo gradiente */
  background: #e2e8f0;
}
.dark .imp-hero-img.imp-card-dark {
  background: var(--imp-panel);
}
.imp-hero-placeholder {
  background: linear-gradient(135deg, #e2e8f0, #cbd5e1) !important;
}
.dark .imp-hero-placeholder {
  background: linear-gradient(135deg, #1a1a2e, #0d0d1a) !important;
}
.imp-hero-img img,
.imp-hero-img .imp-hero-placeholder {
  width: 100%;
  height: 380px;
  object-fit: cover;
  object-position: center;
  display: block;
}
@media (min-width: 640px) {
  .imp-hero-img img,
  .imp-hero-img .imp-hero-placeholder {
    height: 420px;
  }
}
.imp-hero-slider-track { position: relative; width: 100%; height: 380px; }
@media (min-width: 640px) { .imp-hero-slider-track { height: 420px; } }
.imp-hero-slide {
  position: absolute;
  inset: 0;
  opacity: 0;
  transition: opacity 0.35s ease;
  pointer-events: none;
}
.imp-hero-slide.is-active { opacity: 1; pointer-events: auto; }
.imp-hero-slide img { width: 100%; height: 100%; object-fit: cover; display: block; }
.imp-hero-slider-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 3;
  width: 36px;
  height: 36px;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,.25);
  background: rgba(0,0,0,.45);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}
.imp-hero-slider-nav.prev { left: 10px; }
.imp-hero-slider-nav.next { right: 10px; }
.imp-hero-slider-dots {
  position: absolute;
  bottom: 72px;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 6px;
  z-index: 3;
}
.imp-hero-slider-dot {
  width: 7px;
  height: 7px;
  border-radius: 999px;
  background: rgba(255,255,255,.35);
  border: none;
  padding: 0;
  cursor: pointer;
}
.imp-hero-slider-dot.is-active { background: var(--brand-from); width: 18px; }
.imp-resumo-desconto { color: #16a34a !important; font-weight: 700; }
.dark .imp-resumo-desconto { color: #4ade80 !important; }
.imp-resumo-cheio { text-decoration: line-through; color: var(--imp-text-dim) !important; font-size: 12px; }
</style>

<%
  const pctVend = stats.total > 0 ? Math.round(((stats.total - stats.disponiveis) / stats.total) * 100) : 0;
  const vendidos = stats.total - stats.disponiveis;
  const dataFmt  = new Date(rifa.dataSorteio).toLocaleDateString('pt-BR', {weekday:'long',day:'2-digit',month:'long',year:'numeric'});
  const tenantBase = '/' + tenant.slug;
  const galeriaUrls = (rifa.imagens && rifa.imagens.length)
    ? rifa.imagens.map(function(i) { return i.url; })
    : (rifa.imagemUrl ? [rifa.imagemUrl] : []);
  function valorPacoteFaixa(f) {
    const pct = f.percentualDesconto != null ? Number(f.percentualDesconto) : 0;
    if (pct > 0) return f.quantidadeMin * rifa.valorCota * (1 - pct / 100);
    return f.valorTotal;
  }
  let pacotesAtalho = [10, 50, 100];
  if (rifa.pacotesRapidos) {
    try {
      const arr = JSON.parse(rifa.pacotesRapidos);
      if (Array.isArray(arr)) {
        const nums = arr.map(function(n) { return parseInt(n, 10); }).filter(function(n) { return n > 0; });
        if (nums.length) pacotesAtalho = nums.slice(0, 3);
      }
    } catch (e) { /* default */ }
  }
  const detIni = typeof compraDetalheInicial !== 'undefined' ? compraDetalheInicial : { subtotal: 0, total: 0, cheio: 0, economia: 0, pct: null };
  const valorCotaPagina = typeof valorCotaNum !== 'undefined' ? valorCotaNum : (Number(rifa.valorCota) || 0);
  function moedaBr(v) { return Number(v || 0).toFixed(2).replace('.', ','); }
  const temDescIni = detIni.economia > 0.009;
%>

<div class="imp-detail pb-32">
  <div class="max-w-2xl mx-auto px-3 sm:px-4 py-4">

    <!-- Voltar -->
    <a href="<%= tenantBase %>/" class="imp-txt-muted" style="display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:600;margin-bottom:14px;text-decoration:none;">
      <i data-lucide="arrow-left" class="w-4 h-4"></i> Campanhas
    </a>

    <!-- Imagem principal — carrossel -->
    <div class="imp-hero-img imp-card-dark" id="imp-hero-slider">
      <% if (galeriaUrls.length) { %>
        <div class="imp-hero-slider-track">
          <% galeriaUrls.forEach(function(url, gi) { %>
            <div class="imp-hero-slide<%= gi === 0 ? ' is-active' : '' %>" data-slide="<%= gi %>">
              <img src="<%= url %>" alt="<%= rifa.titulo %> — foto <%= gi + 1 %>">
            </div>
          <% }); %>
        </div>
        <% if (galeriaUrls.length > 1) { %>
          <button type="button" class="imp-hero-slider-nav prev" aria-label="Foto anterior" data-hero-prev><i data-lucide="chevron-left" class="w-5 h-5"></i></button>
          <button type="button" class="imp-hero-slider-nav next" aria-label="Próxima foto" data-hero-next><i data-lucide="chevron-right" class="w-5 h-5"></i></button>
          <div class="imp-hero-slider-dots" role="tablist">
            <% galeriaUrls.forEach(function(_, di) { %>
              <button type="button" class="imp-hero-slider-dot<%= di === 0 ? ' is-active' : '' %>" data-hero-dot="<%= di %>" aria-label="Foto <%= di + 1 %>"></button>
            <% }); %>
          </div>
        <% } %>
        <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(18,18,31,.9) 0%,transparent 50%);pointer-events:none;z-index:2;"></div>
      <% } else { %>
        <div class="imp-hero-placeholder" style="background:linear-gradient(135deg,#1a1a2e,#0d0d1a);display:flex;align-items:center;justify-content:center;font-size:5rem;height:380px;">🏆</div>
        <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(18,18,31,.9) 0%,transparent 60%);"></div>
      <% } %>

      <!-- Badge status -->
      <div style="position:absolute;top:12px;left:12px;display:flex;gap:6px;">
        <span style="background:color-mix(in srgb, var(--brand-from) 20%, transparent);border:1px solid color-mix(in srgb, var(--brand-from) 40%, transparent);color:var(--brand-from);padding:4px 10px;border-radius:9999px;font-size:10px;font-weight:900;text-transform:uppercase;">● <%= rifa.status === 'ativa' ? 'ATIVA' : rifa.status.toUpperCase() %></span>
        <% if (pctVend >= 75) { %><span style="background:rgba(249,115,22,.2);border:1px solid rgba(249,115,22,.4);color:#fb923c;padding:4px 10px;border-radius:9999px;font-size:10px;font-weight:900;">🔥 Quase esgotando!</span><% } %>
      </div>

      <div class="imp-hero-caption" style="position:absolute;bottom:0;left:0;right:0;padding:16px;z-index:3;">
        <h1 style="font-size:18px;font-weight:900;margin:0 0 4px;"><%= rifa.titulo %></h1>
        <p style="font-size:12px;margin:0;text-transform:capitalize;">
          Resultado: <%= dataFmt.charAt(0).toUpperCase() + dataFmt.slice(1) %>
        </p>
      </div>
    </div>

    <!-- Barra de progresso -->
    <div class="imp-progress-card imp-fade">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;gap:12px;">
        <p class="imp-txt-muted" style="font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.06em;margin:0;">Progresso da campanha</p>
        <span style="font-size:22px;font-weight:900;color:var(--brand-from);line-height:1;letter-spacing:-.02em;"><%= pctVend %>%</span>
      </div>
      <div class="imp-progress-wrap" role="progressbar" aria-valuenow="<%= pctVend %>" aria-valuemin="0" aria-valuemax="100" aria-label="Progresso da campanha">
        <div class="imp-progress-bar" style="width:<%= Math.max(pctVend, 3) %>%;"></div>
      </div>
      <div style="margin-top:10px;display:flex;justify-content:flex-end;">
        <a href="<%= tenantBase %>/minhas-reservas" class="imp-txt-muted" style="font-size:11px;font-weight:700;text-decoration:none;display:inline-flex;align-items:center;gap:4px;">
          <i data-lucide="ticket" class="w-3.5 h-3.5"></i> Ver minhas cotas
        </a>
      </div>
    </div>

    <!-- Prêmios (pódio) -->
    <%
      const listaPremios = (rifa.premios || []).slice().sort((a, b) => (a.ordem || 0) - (b.ordem || 0));
      const multiPremio = listaPremios.length > 1;
      const medalClass = (i) => (i === 0 ? 'gold' : i === 1 ? 'silver' : 'bronze');
      const rankText = (i) => (i === 0 ? '1º' : i === 1 ? '2º' : '3º');
    %>
    <% if (multiPremio) { %>
    <div class="imp-premios imp-fade">
      <% listaPremios.forEach(function(p, i) {
        const m = medalClass(i);
      %>
        <div class="imp-premio-row is-<%= m %>">
          <div class="imp-premio-medal <%= m %>" aria-hidden="true">
            <span class="rank"><%= rankText(i) %></span>
            <span class="tag">lugar</span>
          </div>
          <div class="imp-premio-body">
            <p class="imp-premio-nome"><%= p.titulo %></p>
            <% if (p.descricao) { %>
              <p class="imp-premio-desc"><%= p.descricao %></p>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
    <% } %>

    <!-- Preço -->
    <div class="imp-panel imp-fade" style="padding:14px 16px;margin-bottom:10px;display:flex;align-items:center;justify-content:space-between;">
      <div>
        <div class="imp-txt-muted" style="font-size:11px;font-weight:700;text-transform:uppercase;margin-bottom:2px;">Por apenas</div>
        <div class="imp-txt" style="font-size:26px;font-weight:900;">R$&nbsp;<%= rifa.valorCota.toFixed(2).replace('.',',') %></div>
      </div>
      <div style="text-align:right;">
        <div class="imp-txt-muted" style="font-size:11px;margin-bottom:4px;">Sorteio em</div>
        <div style="display:flex;gap:5px;flex-wrap:nowrap;">
          <div class="imp-countdown-cell">
            <span id="cd-dias" style="display:block;font-size:15px;font-weight:900;color:var(--brand-from);line-height:1;">--</span>
            <span class="imp-countdown-label">dias</span>
          </div>
          <div class="imp-countdown-cell">
            <span id="cd-horas" style="display:block;font-size:15px;font-weight:900;color:var(--brand-from);line-height:1;">--</span>
            <span class="imp-countdown-label">hrs</span>
          </div>
          <div class="imp-countdown-cell">
            <span id="cd-min" style="display:block;font-size:15px;font-weight:900;color:var(--brand-from);line-height:1;">--</span>
            <span class="imp-countdown-label">min</span>
          </div>
          <div class="imp-countdown-cell">
            <span id="cd-seg" style="display:block;font-size:15px;font-weight:900;color:var(--brand-from);line-height:1;">--</span>
            <span class="imp-countdown-label">seg</span>
          </div>
        </div>
        <p id="sorteio-status" class="hidden" style="font-size:12px;font-weight:800;color:var(--brand-from);margin-top:4px;"></p>
      </div>
    </div>

    <% if (rifa.status === 'ativa') { %>

    <p class="imp-txt-muted" style="font-size:12px;text-align:center;line-height:1.5;margin:0 0 12px;padding:0 4px;">
      Cada número vendido e pago participa do sorteio com a mesma chance individual.
      Comprar mais números aumenta suas chances de forma proporcional.
    </p>

    <% if (rifa.modalidade === 'numeros') { %>
    <!-- ══ GRADE DE NÚMEROS ═══════════════════════════════════════ -->
    <div class="imp-panel imp-fade" style="padding:16px;margin-bottom:10px;" id="comprar-grade">

      <!-- Legenda status -->
      <div style="display:flex;gap:8px;margin-bottom:14px;justify-content:center;">
        <span id="grade-stat-livres" style="background:#374151;color:#d1d5db;font-size:12px;font-weight:700;padding:5px 14px;border-radius:9999px;">— Livres</span>
        <span id="grade-stat-reservados" style="background:rgba(251,191,36,.15);color:#fbbf24;font-size:12px;font-weight:700;padding:5px 14px;border-radius:9999px;">— Reservados</span>
        <span id="grade-stat-pagos" style="background:color-mix(in srgb, var(--brand-from) 15%, transparent);color:var(--brand-from);font-size:12px;font-weight:700;padding:5px 14px;border-radius:9999px;">— Pagos</span>
      </div>

      <div class="grade-legenda">
        <span class="grade-legenda-item"><span class="grade-legenda-dot livre"></span> Livre</span>
        <span class="grade-legenda-item"><span class="grade-legenda-dot reservado"></span> Reservado</span>
        <span class="grade-legenda-item"><span class="grade-legenda-dot pago"></span> Pago</span>
        <span class="grade-legenda-item"><span class="grade-legenda-dot selecionado"></span> Seu número</span>
      </div>

      <!-- Grid de números -->
      <div id="grade-numeros" style="display:grid;grid-template-columns:repeat(10,1fr);gap:5px;margin-bottom:16px;">
        <% for(let i=0; i < rifa.totalNumeros; i++) { %>
        <button type="button"
          class="grade-num-btn disponivel"
          data-num="<%= i+1 %>"
          aria-label="Número <%= String(i).padStart(2,'0') %>">
          <%= String(i).padStart(2,'0') %>
        </button>
        <% } %>
      </div>

      <!-- Selecionados info -->
      <p style="text-align:center;font-size:12px;color:#6b7280;margin:0 0 8px;">
        <span id="grade-selecionados-qtd" style="color:var(--brand-from);font-weight:900;">0</span> número(s) selecionado(s) ·
        Total: <span id="grade-total-label" style="color:var(--brand-from);font-weight:900;">R$ 0,00</span>
      </p>
      <p id="aviso-grade-minima" style="text-align:center;font-size:12px;color:#fbbf24;margin:0 0 10px;" class="hidden">
        Compra mínima: R$ 5,00 — selecione pelo menos <span id="grade-minimo-qtd">1</span> número(s)
      </p>

      <button type="button" id="btn-iniciar-compra-grade" class="imp-btn-green" disabled>
        <i data-lucide="qr-code" class="w-5 h-5"></i>
        Participar · <span id="btn-grade-total-label">R$ 0,00</span>
      </button>
    </div>
    <% } else { %>

    <!-- Pacotes de desconto (faixas) -->
    <% if (rifa.faixasDesconto && rifa.faixasDesconto.length) { %>
    <div class="imp-panel imp-fade" style="padding:10px 12px;margin-bottom:10px;">
      <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px;">
        <span style="font-size:14px;">🔥</span>
        <span class="imp-txt" style="font-weight:800;font-size:13px;">Promoção</span>
        <span class="imp-txt-muted" style="font-size:11px;">Compre mais barato!</span>
      </div>
      <div class="imp-promo-grid">
        <% rifa.faixasDesconto.forEach(function(f, fi) {
          const pctOff = f.percentualDesconto != null ? Number(f.percentualDesconto) : 0;
          const valorPacote = valorPacoteFaixa(f);
        %>
        <button type="button" class="imp-pkg-btn" data-set-qtd="<%= f.quantidadeMin %>">
          <% if (fi === 0) { %><span class="imp-pkg-popular">Popular</span><% } %>
          <% if (pctOff > 0) { %><div class="imp-promo-pct"><%= pctOff %>% OFF</div><% } %>
          <div class="imp-pkg-qty">+<%= f.quantidadeMin.toLocaleString('pt-BR') %></div>
          <div class="imp-pkg-price">R$&nbsp;<%= valorPacote.toFixed(2).replace('.',',') %></div>
          <div class="imp-pkg-select">Selecionar</div>
        </button>
        <% }) %>
      </div>
    </div>
    <% } %>

    <!-- Seção de compra -->
    <div class="imp-panel imp-fade" style="padding:16px;margin-bottom:10px;" id="comprar-cotas">
      <p class="imp-txt-muted" style="font-size:13px;text-align:center;margin:0 0 14px;">Quanto mais títulos, mais chances de ganhar!</p>

      <!-- Pacotes rápidos sem faixas -->
      <% if (!rifa.faixasDesconto || !rifa.faixasDesconto.length) { %>
      <div style="display:grid;grid-template-columns:repeat(<%= Math.min(pacotesAtalho.length, 3) %>,1fr);gap:8px;margin-bottom:14px;">
        <% pacotesAtalho.forEach(function(qtd, pi) {
          const precoPacote = qtd * rifa.valorCota;
          const meio = pacotesAtalho.length >= 2 && pi === Math.floor(pacotesAtalho.length / 2);
        %>
        <button type="button" class="imp-pkg-btn" data-add-qtd="<%= qtd %>" style="padding-top:<%= meio ? '20px' : '14px' %>;">
          <% if (meio) { %><span class="imp-pkg-popular">Mais popular</span><% } %>
          <div style="font-size:15px;font-weight:900;color:var(--brand-from);">+<%= qtd.toLocaleString('pt-BR') %></div>
          <div class="imp-pkg-price-line">R$&nbsp;<%= precoPacote.toFixed(2).replace('.',',') %></div>
          <div class="imp-pkg-select">SELECIONAR</div>
        </button>
        <% }) %>
      </div>
      <% } %>

      <!-- Stepper -->
      <div style="display:flex;align-items:center;justify-content:center;gap:12px;margin-bottom:10px;">
        <button type="button" class="imp-stepper-btn" id="qtd-menos" aria-label="Diminuir">−</button>
        <input type="number" id="input-qtd-cotas" class="imp-stepper-input" value="1" min="1" inputmode="numeric">
        <button type="button" class="imp-stepper-btn" id="qtd-mais" aria-label="Aumentar">+</button>
      </div>

      <p class="imp-txt-muted" style="text-align:center;font-size:12px;margin:0 0 14px;">
        <span id="label-qtd-cotas">1</span> cota(s) selecionada(s)
      </p>
      <p id="aviso-limite-qtd" style="text-align:center;font-size:12px;color:#fbbf24;margin:0 0 6px;" class="hidden"></p>
      <p id="aviso-compra-minima" style="text-align:center;font-size:12px;color:#fbbf24;margin:0 0 6px;<%= detIni.subtotal >= 5 ? 'display:none;' : '' %>">Compra mínima: R$ 5,00</p>

      <p id="page-desconto-hint" class="hidden" style="text-align:center;font-size:11px;color:#fbbf24;font-weight:700;margin:0 0 10px;line-height:1.4;"></p>

      <!-- Resumo -->
      <div class="imp-summary">
        <div class="imp-summary-row"><span>Cotas</span><span id="page-res-qtd" class="imp-summary-val">1</span></div>
        <div id="page-res-cheio-row" class="imp-summary-row" style="display:<%= temDescIni ? 'flex' : 'none' %>;">
          <span>Valor cheio</span><span id="page-res-cheio" class="imp-resumo-cheio">R$ <%= moedaBr(detIni.cheio) %></span>
        </div>
        <div id="page-res-desconto-row" class="imp-summary-row" style="display:<%= temDescIni ? 'flex' : 'none' %>;">
          <span id="page-res-desconto-label"><%= detIni.pct ? 'Desconto (' + detIni.pct + '%)' : 'Desconto' %></span>
          <span id="page-res-desconto" class="imp-resumo-desconto">− R$ <%= moedaBr(detIni.economia) %></span>
        </div>
        <div class="imp-summary-row">
          <span id="page-res-subtotal-label"><%= temDescIni ? 'Subtotal com desconto' : 'Subtotal' %></span><span id="page-res-subtotal" class="imp-summary-val">R$ <%= moedaBr(detIni.subtotal) %></span>
        </div>
        <div id="page-res-economia-badge" style="display:<%= temDescIni ? 'block' : 'none' %>;text-align:center;font-size:11px;font-weight:800;color:#16a34a;padding:4px 0;"><%= temDescIni ? 'Você economiza R$ ' + moedaBr(detIni.economia) + ' nesta compra' : '' %></div>
        <div class="imp-summary-total">
          <span class="imp-summary-label">Total PIX</span>
          <span id="page-res-total" class="imp-summary-total-val">R$ <%= moedaBr(detIni.total) %></span>
        </div>
      </div>

      <button type="button" id="btn-iniciar-compra" class="imp-btn-green"<%= detIni.subtotal < 5 ? ' disabled' : '' %>>
        <i data-lucide="qr-code" class="w-5 h-5"></i>
        Quero participar · <span id="btn-total-label">R$ <%= moedaBr(detIni.total) %></span>
      </button>
    </div>

    <% } /* fim else modalidade cotas */ %>

    <!-- Compartilhar -->
    <div style="margin-bottom:10px;">
      <a href="https://wa.me/?text=<%= whatsappMsg %>" target="_blank" class="imp-btn-outline-sm" style="width:100%;justify-content:center;">
        <i data-lucide="share-2" class="w-4 h-4"></i> Compartilhar no WhatsApp
      </a>
    </div>

    <% } else if (rifa.status === 'finalizada') { %>
    <div style="margin-bottom:10px;">
      <a href="<%= tenantBase %>/rifas/<%= rifa.id %>/resultado" class="imp-btn-green" style="display:flex;">🏆 Ver Resultado do Sorteio</a>
    </div>
    <% } %>

    <!-- Descrição/Regulamento accordion -->
    <% const descricaoRifa = String(rifa.descricao || '').trim(); %>
    <div style="margin-bottom:10px;" class="imp-fade" id="bloco-descricao">
      <button type="button" class="imp-accordion-trigger<%= descricaoRifa ? ' is-open' : '' %>" id="btn-acc-desc" aria-expanded="<%= descricaoRifa ? 'true' : 'false' %>" aria-controls="acc-desc">
        <span>📋 Descrição / Regulamento</span>
        <i data-lucide="chevron-down" class="w-4 h-4 imp-acc-chevron"></i>
      </button>
      <div id="acc-desc" class="imp-accordion-panel<%= descricaoRifa ? ' is-open' : '' %>" role="region" aria-labelledby="btn-acc-desc">
        <% if (descricaoRifa) { %>
          <p style="font-size:14px;color:#d1d5db;line-height:1.7;white-space:pre-line;margin:0;"><%= descricaoRifa %></p>
        <% } else { %>
          <p style="font-size:14px;color:#6b7280;line-height:1.7;margin:0;">Nenhuma descrição fornecida pelo organizador.</p>
        <% } %>
      </div>
    </div>

    <!-- Depoimentos -->
    <div class="imp-panel imp-fade" style="padding:16px;border-radius:14px;" id="comentarios">
      <h2 class="imp-txt" style="font-size:15px;font-weight:800;margin:0 0 14px;display:flex;align-items:center;gap:6px;">
        <i data-lucide="message-circle" class="w-4 h-4" style="color:var(--brand-from);"></i> Depoimentos
      </h2>
      <div id="lista-comentarios" style="display:flex;flex-direction:column;gap:10px;">
        <% if (!(comentarios || []).length) { %>
          <p id="depoimentos-vazio" style="font-size:13px;color:#6b7280;text-align:center;padding:16px 0;margin:0;">Seja o primeiro a comentar!</p>
        <% } %>
        <% (comentarios || []).forEach(function(c) { %>
          <div class="depoimento-item imp-soft-box" style="display:flex;gap:10px;padding:12px;">
            <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--brand-from),var(--brand-to));display:flex;align-items:center;justify-content:center;font-weight:900;font-size:14px;color:#000;flex-shrink:0;"><%= c.usuario.nome.charAt(0).toUpperCase() %></div>
            <div>
              <p class="imp-txt depoimento-texto" style="font-size:13px;margin:0 0 4px;"><%= c.texto %></p>
              <p class="imp-txt-muted" style="font-size:11px;margin:0;"><%= c.usuario.nome %> · <%= new Date(c.createdAt).toLocaleDateString('pt-BR') %></p>
            </div>
          </div>
        <% }); %>
      </div>

      <form id="form-depoimento" style="margin-top:14px;padding-top:14px;border-top:1px solid var(--imp-panel-border);display:flex;flex-direction:column;gap:10px;">
        <p class="imp-txt-muted" style="font-size:11px;margin:0;display:flex;align-items:flex-start;gap:6px;">
          <i data-lucide="shield-check" class="w-3.5 h-3.5" style="color:var(--brand-from);flex-shrink:0;margin-top:1px;"></i>
          Somente quem comprou com pagamento confirmado pode comentar.
        </p>
        <input type="text" name="cpf" id="depoimento-cpf" required placeholder="Seu CPF (000.000.000-00)" inputmode="numeric" maxlength="14"
          class="imp-input" style="border-radius:10px;padding:11px 14px;font-size:13px;width:100%;">
        <textarea name="texto" rows="3" maxlength="500" required placeholder="Conte como foi sua experiência..."
          class="imp-input" style="border-radius:10px;padding:11px 14px;font-size:13px;width:100%;resize:none;"></textarea>
        <button type="submit" class="imp-btn-green" style="font-size:13px;padding:12px;">
          <i data-lucide="send" class="w-4 h-4"></i> Enviar depoimento
        </button>
      </form>
    </div>

  </div>
</div>

<!-- ══ STICKY BAR MOBILE ══════════════════════════════════════════ -->
<% if (rifa.status === 'ativa') { %>
<div id="sticky-buy" class="imp-sticky-buy lg:hidden fixed bottom-0 inset-x-0 z-40"
     style="padding:12px 16px;">
  <div style="display:flex;align-items:center;gap:12px;max-width:480px;margin:0 auto;">
    <div style="flex:1;">
      <div class="imp-txt-muted" style="font-size:11px;"><span id="sticky-qtd">1</span> cota(s)</div>
      <div style="font-size:18px;font-weight:900;color:var(--brand-from);" id="sticky-total">R$ 0,00</div>
    </div>
    <button id="btn-comprar-mobile" class="imp-btn-green" style="flex:1;max-width:180px;padding:12px 16px;font-size:14px;">
      <i data-lucide="qr-code" class="w-4 h-4"></i> Participar
    </button>
  </div>
</div>
<% } %>

<!-- ══ MODAL COMPRA ══════════════════════════════════════════════ -->
<div id="modal-compra" class="fixed inset-0 z-50 hidden flex items-end sm:items-center justify-center p-0 sm:p-4" style="background:rgba(0,0,0,.8);">
  <div class="imp-panel imp-modal-sheet sm:rounded-2xl pb-safe" style="width:100%;max-width:480px;border-radius:20px 20px 0 0;overflow-y:auto;max-height:92vh;">
    <div style="width:48px;height:4px;background:var(--imp-progress-track);border-radius:9999px;margin:12px auto 0;" class="sm:hidden"></div>
    <div class="imp-modal-head" style="padding:16px 20px;display:flex;align-items:center;justify-content:space-between;">
      <h3 class="imp-txt" style="font-weight:800;font-size:16px;margin:0;">Finalizar compra</h3>
      <button id="btn-fechar-modal" class="imp-stepper-btn" style="width:auto;height:auto;padding:8px;border:none;" type="button">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>
    <div style="padding:20px;">
      <div id="timer-reserva" style="display:none;background:rgba(251,191,36,.08);border:1px solid rgba(251,191,36,.2);border-radius:10px;padding:10px 14px;margin-bottom:14px;font-size:13px;color:#b45309;display:flex;align-items:center;gap:8px;">
        <i data-lucide="clock" class="w-4 h-4"></i>
        Reserva expira em <strong id="timer-texto" style="margin-left:4px;"><%= typeof tempoReservaMin !== 'undefined' ? tempoReservaMin : 10 %>:00</strong>
      </div>
      <div style="margin-bottom:14px;">
        <div class="imp-txt-muted" style="font-size:11px;font-weight:700;text-transform:uppercase;margin-bottom:8px;">Suas cotas</div>
        <div id="numeros-selecionados" class="imp-txt" style="font-size:13px;"></div>
      </div>
      <div id="checkout-resumo" class="imp-soft-box" style="display:none;padding:14px;margin-bottom:14px;font-size:13px;">
        <div id="checkout-cheio-row" class="hidden" style="display:flex;justify-content:space-between;color:var(--imp-text-muted);margin-bottom:6px;">
          <span>Valor cheio</span><span id="checkout-cheio" class="imp-resumo-cheio">R$ 0,00</span>
        </div>
        <div id="checkout-desconto-row" class="hidden" style="display:flex;justify-content:space-between;color:var(--imp-text-muted);margin-bottom:6px;">
          <span id="checkout-desconto-label">Desconto</span><span id="checkout-desconto" class="imp-resumo-desconto">− R$ 0,00</span>
        </div>
        <div class="imp-summary-row" style="margin-bottom:6px;"><span id="checkout-subtotal-label">Subtotal</span><span id="checkout-subtotal" class="imp-summary-val">R$ 0,00</span></div>
        <div class="imp-summary-total" style="margin-top:0;padding-top:10px;">
          <span class="imp-summary-label">Total PIX</span><span id="valor-total" class="imp-summary-total-val">R$ 0,00</span>
        </div>
      </div>
      <form id="form-compra" style="display:flex;flex-direction:column;gap:10px;">
        <input type="text" name="nome" required placeholder="Nome completo *"
          class="imp-input" style="border-radius:10px;padding:12px 14px;font-size:14px;width:100%;">
        <input type="email" name="email" required placeholder="E-mail *" autocomplete="email" id="input-email"
          class="imp-input" style="border-radius:10px;padding:12px 14px;font-size:14px;width:100%;">
        <input type="text" name="cpf" required placeholder="000.000.000-00" inputmode="numeric" maxlength="14" id="input-cpf"
          class="imp-input" style="border-radius:10px;padding:12px 14px;font-size:14px;width:100%;">
        <input type="tel" name="telefone" required placeholder="(11) 99999-9999" inputmode="numeric" maxlength="15" id="input-telefone"
          class="imp-input" style="border-radius:10px;padding:12px 14px;font-size:14px;width:100%;">
        <button type="submit" id="btn-confirmar" disabled class="imp-btn-green" style="margin-top:4px;font-size:15px;padding:15px;">
          <i data-lucide="qr-code" class="w-5 h-5"></i> Pagar via PIX
        </button>
      </form>
    </div>
  </div>
</div>

<!-- ══ MODAL SUCESSO ═════════════════════════════════════════════ -->
<div id="modal-sucesso" class="fixed inset-0 z-50 hidden flex items-end sm:items-center justify-center p-0 sm:p-4" style="background:rgba(0,0,0,.85);">
  <div class="imp-panel imp-modal-sheet sm:rounded-2xl pb-safe" style="width:100%;max-width:440px;border-radius:20px 20px 0 0;overflow-y:auto;max-height:92vh;border-color:color-mix(in srgb, var(--brand-from) 25%, var(--imp-panel-border));">
    <div style="width:48px;height:4px;background:var(--imp-progress-track);border-radius:9999px;margin:12px auto 0;" class="sm:hidden"></div>
    <div style="padding:24px 20px;text-align:center;">
      <div style="width:56px;height:56px;border-radius:50%;background:color-mix(in srgb, var(--brand-from) 15%, transparent);border:2px solid color-mix(in srgb, var(--brand-from) 30%, transparent);display:flex;align-items:center;justify-content:center;margin:0 auto 12px;">
        <i data-lucide="check-circle" class="w-9 h-9" style="color:var(--brand-from);"></i>
      </div>
      <h3 class="imp-txt" style="font-size:18px;font-weight:900;margin:0 0 6px;">Reserva Confirmada!</h3>
      <p class="imp-txt-muted" style="font-size:13px;margin:0 0 16px;">Realize o pagamento PIX para garantir seus números</p>
      <div id="sucesso-detalhes" class="imp-txt" style="text-align:left;font-size:13px;"></div>
      <a id="link-comprovante" href="#" class="imp-btn-green" style="display:flex;margin-top:16px;">Ver Comprovante</a>
      <button id="btn-fechar-sucesso" class="imp-txt-muted" style="background:transparent;border:none;font-size:13px;padding:10px;cursor:pointer;width:100%;margin-top:8px;">Fechar</button>
    </div>
  </div>
</div>

<script>
<%- include('../partials/rifa-compra-pricing-inline') %>
  const TENANT_SLUG = '<%= tenant.slug %>';
  const API_BASE = '/<%= tenant.slug %>/api';
  const RIFA_ID = <%= rifa.id %>;
  const VALOR_COTA = <%= valorCotaPagina %>;
  const COTAS_DISPONIVEIS = <%= stats.disponiveis %>;
  const QTD_MAX = Math.min(5000, <%= stats.disponiveis %>);
  const RIFA_ATIVA = <%= rifa.status === 'ativa' ? 'true' : 'false' %>;
  const MODALIDADE = '<%= rifa.modalidade || "cotas" %>';
  const TOTAL_NUMEROS = <%= rifa.totalNumeros %>;
  const FAIXAS_RAW = <%- JSON.stringify(rifa.faixasDesconto || []) %>;
  const FAIXAS = (FAIXAS_RAW || []).map(function (f) {
    return {
      quantidadeMin: f.quantidadeMin != null ? f.quantidadeMin : f.quantidade_min,
      valorTotal: f.valorTotal != null ? f.valorTotal : f.valor_total,
      percentualDesconto: f.percentualDesconto != null ? f.percentualDesconto : f.percentual_desconto
    };
  });
  const TEMPO_RESERVA_MIN = <%= typeof tempoReservaMin !== 'undefined' ? tempoReservaMin : 10 %>;
  const CODIGO_INDICACAO = '<%= codigoIndicacao || '' %>';
  const DATA_SORTEIO = '<%= new Date(rifa.dataSorteio).toISOString() %>';

  /* Accordion descrição */
  (function () {
    var btn = document.getElementById('btn-acc-desc');
    var panel = document.getElementById('acc-desc');
    if (!btn || !panel) return;
    btn.addEventListener('click', function () {
      var open = panel.classList.toggle('is-open');
      btn.classList.toggle('is-open', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  })();

  /* Countdown sorteio */
  (function () {
    var alvo = new Date(DATA_SORTEIO).getTime();
    var els = {
      dias: document.getElementById('cd-dias'),
      horas: document.getElementById('cd-horas'),
      min: document.getElementById('cd-min'),
      seg: document.getElementById('cd-seg'),
      status: document.getElementById('sorteio-status')
    };
    if (!els.dias) return;
    function pad(n) { return String(n).padStart(2, '0'); }
    function tick() {
      var diff = alvo - Date.now();
      if (diff <= 0) {
        if (els.status) { els.status.style.display='block'; els.status.textContent = '<%= rifa.status === "finalizada" ? "Sorteio realizado!" : "Sorteio em andamento!" %>'; }
        if (els.dias) els.dias.textContent = '0';
        if (els.horas) els.horas.textContent = '00';
        if (els.min) els.min.textContent = '00';
        if (els.seg) els.seg.textContent = '00';
        clearInterval(iv); return;
      }
      els.dias.textContent  = Math.floor(diff / 86400000);
      els.horas.textContent = pad(Math.floor((diff % 86400000) / 3600000));
      els.min.textContent   = pad(Math.floor((diff % 3600000) / 60000));
      if (els.seg) els.seg.textContent = pad(Math.floor((diff % 60000) / 1000));
    }
    tick();
    var iv = setInterval(tick, 1000);
  })();

  (function heroSlider() {
    var root = document.getElementById('imp-hero-slider');
    if (!root) return;
    var slides = root.querySelectorAll('.imp-hero-slide');
    if (slides.length < 2) return;
    var dots = root.querySelectorAll('[data-hero-dot]');
    var idx = 0;
    function go(n) {
      idx = (n + slides.length) % slides.length;
      slides.forEach(function (s, i) { s.classList.toggle('is-active', i === idx); });
      dots.forEach(function (d, i) { d.classList.toggle('is-active', i === idx); });
    }
    root.querySelector('[data-hero-prev]')?.addEventListener('click', function () { go(idx - 1); });
    root.querySelector('[data-hero-next]')?.addEventListener('click', function () { go(idx + 1); });
    dots.forEach(function (d) {
      d.addEventListener('click', function () { go(parseInt(d.dataset.heroDot, 10)); });
    });
    var touchX = 0;
    root.addEventListener('touchstart', function (e) { touchX = e.changedTouches[0].screenX; }, { passive: true });
    root.addEventListener('touchend', function (e) {
      var dx = e.changedTouches[0].screenX - touchX;
      if (Math.abs(dx) > 40) go(dx < 0 ? idx + 1 : idx - 1);
    }, { passive: true });
    setInterval(function () { go(idx + 1); }, 6000);
  })();

  window.__pendingScripts = window.__pendingScripts || [];
  window.__pendingScripts.push('/js/rifa-detalhe.js?v=6');
</script>

<%- include('../partials/footer', { tenantPublic: true }) %>
