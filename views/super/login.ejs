<%- include('partials/layout-start') %>

<div class="super-login-page">
  <div class="super-login-card">
    <div class="super-login-logo">
      <img src="/img/vourifar-logo.png" alt="VouRifar" height="40">
    </div>

    <% if (typeof erro !== 'undefined' && erro) { %><div class="super-login-alert"><%= erro %></div><% } %>
    <% if (typeof msg !== 'undefined' && msg) { %><div class="super-login-alert" style="background:#ecfdf5;color:#065f46;border-color:#a7f3d0;"><%= msg %></div><% } %>

    <form method="POST" action="/super/login">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="text" name="usuario" required autocomplete="username" placeholder="E-mail ou usuário" class="super-login-field">
      <input type="password" name="senha" required autocomplete="current-password" placeholder="Senha" class="super-login-field">
      <button type="submit" class="super-login-btn">Entrar</button>
    </form>
  </div>
</div>

<%- include('partials/layout-end') %>
