<%- include('partials/page-start') %>
<%- include('partials/alerts') %>

<section class="super-panel">
  <div class="super-panel-head">
    <div>
      <h2 class="super-panel-title">Organizadores</h2>
      <p class="super-panel-sub"><%= total %> cadastro<%= total !== 1 ? 's' : '' %> · página <%= page %> de <%= paginas %></p>
    </div>
    <form method="GET" action="/super/organizadores" class="super-filters">
      <input type="hidden" name="filtro" value="<%= filtro || '' %>">
      <input type="text" name="q" value="<%= busca %>" placeholder="Buscar nome, e-mail ou sistema…" class="super-input">
      <button type="submit" class="super-btn super-btn--primary"><i data-lucide="search" class="w-4 h-4"></i> Filtrar</button>
      <% if (busca || filtro) { %><a href="/super/organizadores" class="super-btn super-btn--ghost">Limpar</a><% } %>
    </form>
  </div>

  <div class="super-filters mb-4 flex flex-wrap items-center gap-2">
    <a href="/super/organizadores" class="super-btn super-btn--ghost <%= !filtro ? 'is-active' : '' %>">Todos</a>
    <a href="/super/organizadores?filtro=sem_rifa" class="super-btn super-btn--ghost <%= filtro === 'sem_rifa' ? 'is-active' : '' %>">Sem rifa</a>
    <a href="/super/organizadores?filtro=leads_quentes" class="super-btn super-btn--ghost <%= filtro === 'leads_quentes' ? 'is-active' : '' %>">
      Leads quentes<% if (typeof leadsQuentesPendentes !== 'undefined' && leadsQuentesPendentes > 0) { %> (<%= leadsQuentesPendentes %>)<% } %>
    </a>
    <% if (typeof leadsQuentesPendentes !== 'undefined' && leadsQuentesPendentes > 0) { %>
      <form method="POST" action="/super/organizadores/campanha-leads-quentes" class="inline"
            onsubmit="return confirm('Enviar campanha para <%= leadsQuentesPendentes %> lead(s) com carteira configurada e sem rifa?');">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="super-btn super-btn--primary">
          <i data-lucide="mail" class="w-4 h-4"></i> Campanha leads quentes (<%= leadsQuentesPendentes %>)
        </button>
      </form>
    <% } %>
  </div>

  <div class="super-table-wrap">
    <table class="super-table">
      <thead>
        <tr>
          <th>Nome</th>
          <th>E-mail</th>
          <th>Sistema</th>
          <th>Chave PIX / Recebimento</th>
          <th>Rifas</th>
          <th>Saldo confirmado</th>
          <th>Pendente</th>
          <th>Modalidade</th>
          <th>Disponível</th>
          <th>Login</th>
          <th>Cadastro</th>
          <th>Onboarding</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% if (!organizadores.length) { %>
          <tr><td colspan="13" class="super-empty">Nenhum organizador encontrado.</td></tr>
        <% } %>
        <% organizadores.forEach(function(o) {
          const saldoConf = o.saldo ? o.saldo.confirmado : 0;
          const saldoPend = o.saldo ? o.saldo.pendente : 0;
          const payment = o.payment || {};
          const isWoovi = payment.gateway === 'woovi';
          const taxaLabel = isWoovi ? '5% + R$ 0,50/cota' : '—';
          const saldoDisp = o.saldoDisponivel != null ? o.saldoDisponivel : 0;
          const temPix = !!(o.tenant.pixChave);
          const totalRifas = o.totalRifas != null ? o.totalRifas : 0;
        %>
          <tr>
            <td class="super-tenant-name"><%= o.nome %></td>
            <td><%= o.email %></td>
            <td>
              <a href="/<%= o.tenant.slug %>/" target="_blank" rel="noopener" class="super-action-link"><%= o.tenant.nome %></a>
              <span class="super-tenant-email">/<%= o.tenant.slug %></span>
            </td>

            <td class="super-pix-cell">
              <% if (o.pixInfo && o.pixInfo.valor) { %>
                <span class="super-badge super-badge--pix-ok text-[10px]"><%= o.pixInfo.tipo %></span>
                <span class="super-pix-key" title="<%= o.pixInfo.valor %>"><%= o.pixInfo.valor %></span>
              <% } else { %>
                <span class="text-gray-400 text-xs">—</span>
              <% } %>
            </td>

            <td>
              <% if (totalRifas === 0) { %>
                <span class="super-badge super-badge--pix-no">0</span>
              <% } else { %>
                <span class="super-badge super-badge--pix-ok"><%= totalRifas %></span>
              <% } %>
            </td>

            <td>
              <% if (saldoConf > 0) { %>
                <span class="font-bold text-emerald-600 dark:text-emerald-400">
                  R$ <%= saldoConf.toFixed(2).replace('.', ',') %>
                </span>
              <% } else { %>
                <span class="text-gray-400">R$ 0,00</span>
              <% } %>
            </td>

            <td>
              <% if (saldoPend > 0) { %>
                <span class="text-amber-600 dark:text-amber-400">
                  R$ <%= saldoPend.toFixed(2).replace('.', ',') %>
                </span>
              <% } else { %>
                <span class="text-gray-400">—</span>
              <% } %>
            </td>

            <td>
              <% if (isWoovi) { %>
                <span class="super-badge super-badge--modalidade-woovi">Plataforma · <%= taxaLabel %></span>
              <% } else { %>
                <span class="super-badge super-badge--modalidade-none"><%= payment.gatewayLabel || 'Não configurado' %></span>
              <% } %>
            </td>

            <td>
              <% if (saldoDisp >= 50 && isWoovi) { %>
                <span class="super-badge <%= saldoDisp >= 500 ? 'super-badge--saldo-ok' : 'super-badge--saldo-medio' %>">
                  <%= saldoDisp >= 500 ? '✓' : '$' %> R$ <%= saldoDisp.toFixed(2).replace('.', ',') %>
                </span>
                <span class="super-valor-hint">para saque</span>
              <% } else if (saldoDisp > 0) { %>
                <span class="super-valor-muted">R$ <%= saldoDisp.toFixed(2).replace('.', ',') %></span>
              <% } else { %>
                <span class="super-valor-muted">—</span>
              <% } %>
            </td>

            <td>
              <span class="super-badge <%= o.viaGoogle ? 'super-badge--pix-ok' : 'super-badge--pix-no' %>">
                <%= o.viaGoogle ? 'Google' : 'E-mail' %>
              </span>
            </td>
            <td><%= o.createdAtFmt %></td>

            <td>
              <div class="flex flex-col gap-1 text-[10px]">
                <span class="<%= o.nurtureD1 ? 'text-emerald-600' : 'text-gray-400' %>">D+1 <%= o.nurtureD1 ? '✓' : '—' %></span>
                <span class="<%= o.nurtureD3 ? 'text-emerald-600' : 'text-gray-400' %>">D+3 <%= o.nurtureD3 ? '✓' : '—' %></span>
                <span class="<%= o.campanhaLeads ? 'text-emerald-600' : 'text-gray-400' %>">Camp. <%= o.campanhaLeads ? '✓' : '—' %></span>
              </div>
            </td>

            <td>
              <div class="flex flex-col items-start gap-1">
                <a href="/<%= o.tenant.slug %>/admin" target="_blank" rel="noopener" class="super-action-link">Painel</a>
                <% if (!temPix && !isMp) { %>
                  <span class="text-[10px] text-red-500 font-bold">Sem PIX</span>
                <% } %>
                <% if (totalRifas === 0) { %>
                  <form method="POST" action="/super/organizadores/<%= o.id %>/nurture-email" class="inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="tipo" value="d1">
                    <input type="hidden" name="redirect" value="/super/organizadores<%= filtro ? '?filtro=' + filtro : '' %><%= busca ? (filtro ? '&' : '?') + 'q=' + encodeURIComponent(busca) : '' %>">
                    <button type="submit" class="super-action-link text-[11px]" <%= o.nurtureD1 ? 'disabled' : '' %>>E-mail D+1</button>
                  </form>
                <% } %>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% if (paginas > 1) { %>
    <div class="super-pagination">
      <span><%= total %> organizadores</span>
      <div class="super-pagination-links">
        <% const qParam = busca ? '&q=' + encodeURIComponent(busca) : ''; const fParam = filtro ? '&filtro=' + filtro : ''; %>
        <% if (page > 1) { %><a class="super-page-link" href="/super/organizadores?page=<%= page - 1 %><%= qParam %><%= fParam %>">←</a><% } %>
        <% for (var p = Math.max(1, page - 2); p <= Math.min(paginas, page + 2); p++) { %>
          <a class="super-page-link <%= p === page ? 'is-active' : '' %>" href="/super/organizadores?page=<%= p %><%= qParam %><%= fParam %>"><%= p %></a>
        <% } %>
        <% if (page < paginas) { %><a class="super-page-link" href="/super/organizadores?page=<%= page + 1 %><%= qParam %><%= fParam %>">→</a><% } %>
      </div>
    </div>
  <% } %>
</section>

<%- include('partials/page-end') %>
