<%- include('partials/page-start') %>
<%- include('partials/alerts') %>

<style>
  .plat-section-title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: #94a3b8;
    margin: 28px 0 12px;
  }
  .plat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 14px;
  }
  .plat-card {
    background: var(--super-panel-bg, #fff);
    border: 1px solid var(--super-border, #e2e8f0);
    border-radius: 10px;
    padding: 18px 20px;
  }
  .plat-card-label {
    font-size: 12px;
    color: #64748b;
    margin: 0 0 6px;
    font-weight: 500;
  }
  .plat-card-value {
    font-size: 26px;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
    line-height: 1.1;
  }
  .plat-card-value--green { color: #047857; }
  .plat-card-value--blue  { color: #1d4ed8; }
  .plat-card-value--amber { color: #92400e; }
  .plat-card-hint {
    font-size: 11px;
    color: #94a3b8;
    margin: 4px 0 0;
  }
  @media (prefers-color-scheme: dark) {
    .plat-card { background: #1e293b; border-color: #334155; }
    .plat-card-value { color: #f1f5f9; }
    .plat-card-label { color: #94a3b8; }
  }
</style>

<%# ── SISTEMAS ────────────────────────────────── %>
<p class="plat-section-title">Sistemas</p>
<div class="plat-grid">
  <div class="plat-card">
    <p class="plat-card-label">Sistemas ativos</p>
    <p class="plat-card-value"><%= metricas.totalTenants %></p>
    <% if (metricas.tenantsSuspensos > 0) { %>
      <p class="plat-card-hint"><%= metricas.tenantsSuspensos %> suspenso<%= metricas.tenantsSuspensos > 1 ? 's' : '' %></p>
    <% } %>
  </div>
  <div class="plat-card">
    <p class="plat-card-label">Novos este mês</p>
    <p class="plat-card-value plat-card-value--blue"><%= metricas.novosTenantsMes %></p>
  </div>
  <div class="plat-card">
    <p class="plat-card-label">Organizadores</p>
    <p class="plat-card-value"><%= metricas.totalOrganizadores %></p>
  </div>
  <div class="plat-card">
    <p class="plat-card-label">Compradores</p>
    <p class="plat-card-value"><%= info.totalUsuarios %></p>
  </div>
  <div class="plat-card">
    <p class="plat-card-label">Carteira PIX configurada</p>
    <p class="plat-card-value plat-card-value--green"><%= info.tenantsWoovi %></p>
    <p class="plat-card-hint">Woovi / plataforma</p>
  </div>
</div>

<%# ── RIFAS ───────────────────────────────────── %>
<p class="plat-section-title">Rifas</p>
<div class="plat-grid">
  <div class="plat-card">
    <p class="plat-card-label">Ativas agora</p>
    <p class="plat-card-value plat-card-value--green"><%= metricas.rifasAtivas %></p>
  </div>
  <div class="plat-card">
    <p class="plat-card-label">Finalizadas</p>
    <p class="plat-card-value"><%= info.rifasFinalizadas %></p>
  </div>
  <div class="plat-card">
    <p class="plat-card-label">Canceladas</p>
    <p class="plat-card-value plat-card-value--amber"><%= info.rifasCanceladas %></p>
  </div>
  <div class="plat-card">
    <p class="plat-card-label">Total criadas</p>
    <p class="plat-card-value"><%= metricas.totalRifas %></p>
  </div>
</div>

<%# ── VENDAS ──────────────────────────────────── %>
<p class="plat-section-title">Vendas</p>
<div class="plat-grid">
  <div class="plat-card">
    <p class="plat-card-label">GMV total</p>
    <p class="plat-card-value">R$ <%= metricas.gmvTotalFmt %></p>
    <p class="plat-card-hint">só vendas Woovi (PIX)</p>
  </div>
  <div class="plat-card">
    <p class="plat-card-label">GMV este mês</p>
    <p class="plat-card-value plat-card-value--blue">R$ <%= info.gmvMesFmt %></p>
    <p class="plat-card-hint"><%= info.vendasMes %> venda<%= info.vendasMes !== 1 ? 's' : '' %> Woovi</p>
  </div>
  <div class="plat-card">
    <p class="plat-card-label">Vendas confirmadas</p>
    <p class="plat-card-value plat-card-value--green"><%= metricas.reservasConfirmadas %></p>
  </div>
  <div class="plat-card">
    <p class="plat-card-label">Reservas pendentes</p>
    <p class="plat-card-value plat-card-value--amber"><%= info.reservasPendentes %></p>
  </div>
  <div class="plat-card">
    <p class="plat-card-label">Ticket médio</p>
    <p class="plat-card-value">R$ <%= metricas.ticketMedioFmt %></p>
  </div>
  <div class="plat-card">
    <p class="plat-card-label">Taxa de conversão</p>
    <p class="plat-card-value <%= parseFloat(metricas.taxaConversao) >= 50 ? 'plat-card-value--green' : 'plat-card-value--amber' %>"><%= metricas.taxaConversao %>%</p>
    <p class="plat-card-hint">confirmadas / total reservas</p>
  </div>
</div>

<%# ── RECEITA ─────────────────────────────────── %>
<p class="plat-section-title">Receita da plataforma (este mês · Woovi)</p>
<div class="plat-grid">
  <div class="plat-card">
    <p class="plat-card-label">Lucro do mês</p>
    <p class="plat-card-value plat-card-value--green">R$ <%= metricas.lucroTotalFmt %></p>
    <p class="plat-card-hint">comissões + taxas de saque · só PIX Woovi</p>
  </div>
  <div class="plat-card">
    <p class="plat-card-label">Comissões PIX</p>
    <p class="plat-card-value">R$ <%= metricas.receitaPlataformaFmt %></p>
    <p class="plat-card-hint">5% + R$ 0,50/cota · este mês</p>
  </div>
  <div class="plat-card">
    <p class="plat-card-label">Taxas de saque</p>
    <p class="plat-card-value">R$ <%= metricas.totalTaxasSaqueFmt %></p>
    <p class="plat-card-hint">saques concluídos este mês</p>
  </div>
</div>

<%# ── SALDOS WOOVI ────────────────────────────── %>
<p class="plat-section-title">Saldos Woovi</p>
<div class="plat-grid">
  <div class="plat-card">
    <p class="plat-card-label">Saldo da conta</p>
    <p class="plat-card-value">R$ <%= wooviSaldos.contaSaldoFmt %></p>
    <p class="plat-card-hint">conta Lemon (Woovi)</p>
  </div>
  <div class="plat-card">
    <p class="plat-card-label">Saldo das subcontas</p>
    <p class="plat-card-value">R$ <%= wooviSaldos.subcontasEstimadoFmt %></p>
    <p class="plat-card-hint">
      <% if (wooviSaldos.subcontasFonte === 'api') { %>
        API Woovi<%= wooviSaldos.subcontasAtualizadoHint ? ' · atualizado ' + wooviSaldos.subcontasAtualizadoHint : '' %>
      <% } else { %>
        estimado (DB) · sincronizando com Woovi…
      <% } %>
    </p>
  </div>
  <div class="plat-card">
    <p class="plat-card-label">Saldo disponível</p>
    <p class="plat-card-value plat-card-value--green">R$ <%= wooviSaldos.saldoDisponivelFmt %></p>
    <p class="plat-card-hint">caixa da plataforma · conta − subcontas</p>
  </div>
</div>

<%# ── SAQUES ──────────────────────────────────── %>
<p class="plat-section-title">Saques</p>
<div class="plat-grid">
  <div class="plat-card">
    <p class="plat-card-label">Total sacado</p>
    <p class="plat-card-value">R$ <%= info.totalSacadoFmt %></p>
    <p class="plat-card-hint"><%= info.countSaquesConcluidos %> saque<%= info.countSaquesConcluidos !== 1 ? 's' : '' %> concluído<%= info.countSaquesConcluidos !== 1 ? 's' : '' %></p>
  </div>
  <div class="plat-card">
    <p class="plat-card-label">Taxas retidas</p>
    <p class="plat-card-value plat-card-value--green">R$ <%= info.totalTaxasSaqueFmt %></p>
    <p class="plat-card-hint">lucro dos saques</p>
  </div>
  <div class="plat-card">
    <p class="plat-card-label">Saques pendentes</p>
    <p class="plat-card-value plat-card-value--amber"><%= info.countSaquesPendentes %></p>
    <p class="plat-card-hint">R$ <%= info.saquesPendentesFmt %> em fila</p>
  </div>
</div>

<%- include('partials/page-end') %>
