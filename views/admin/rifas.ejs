<!DOCTYPE html>
<html lang="pt-BR" class="admin-panel">
<head>
  <%- include('partials/head') %>
</head>
<body class="admin-panel" x-data="{
  modalNovaRifa: false,
  wizardStep: 1,
  titulo: '',
  valorCota: 10,
  totalCotas: 100,
  dataSorteio: '',
  modalidade: 'cotas',
  premioModo: 'unico',
  premio1: '',
  premio2: '',
  premio3: '',
  get podeGrade() { return this.totalCotas >= 1 && this.totalCotas <= 100; },
  carteiraOk: <%= typeof carteiraOk !== 'undefined' ? carteiraOk : 'false' %>,
  organizadorPercentual: <%= typeof organizadorPercentual !== 'undefined' ? organizadorPercentual : 0.95 %>,
  taxaFixaCota: <%= typeof taxaFixaCota !== 'undefined' ? taxaFixaCota : 0.5 %>,
  get taxaCota() { return Math.max(0, this.valorCota) * (1 - this.organizadorPercentual) + this.taxaFixaCota; },
  get compradorPaga() { return Math.max(0, this.valorCota); },
  get faturamentoTotal() { return Math.max(0, (this.valorCota * this.organizadorPercentual - this.taxaFixaCota)) * Math.max(0, this.totalCotas); },
  get volumeCompradores() { return this.compradorPaga * Math.max(0, this.totalCotas); },
  get taxaPlataformaTotal() { return this.volumeCompradores - this.faturamentoTotal; },
  fmt(v) { return (Math.max(0, v) || 0).toFixed(2).replace('.', ','); },
  fmtInt(v) { return Math.max(0, Math.round(v) || 0).toLocaleString('pt-BR'); },
  resetWizard() {
    this.wizardStep = 1;
    this.titulo = '';
    this.valorCota = 10;
    this.totalCotas = 100;
    this.dataSorteio = '';
    this.modalidade = 'cotas';
    this.premioModo = 'unico';
    this.premio1 = '';
    this.premio2 = '';
    this.premio3 = '';
  },
  openWizard() {
    this.resetWizard();
    this.modalNovaRifa = true;
  },
  validStep1() {
    if (!(this.titulo.trim().length >= 3 && this.valorCota > 0 && this.totalCotas >= 1)) return false;
    if (this.premioModo === 'podio') {
      return this.premio1.trim() && this.premio2.trim() && this.premio3.trim();
    }
    if (this.premioModo === 'duplo') {
      return this.premio1.trim() && this.premio2.trim();
    }
    return !!this.premio1.trim();
  },
  validStep2() { return !!this.dataSorteio; },
  nextStep() {
    if (this.wizardStep === 1 && !this.validStep1()) {
      const msg = this.premioModo === 'podio'
        ? 'Preencha nome, valor, cotas e os três prêmios (1º, 2º e 3º).'
        : this.premioModo === 'duplo'
          ? 'Preencha nome, valor, cotas e os dois prêmios (1º e 2º).'
          : 'Preencha nome, valor, cotas e o prêmio.';
      return alert(msg);
    }
    if (this.wizardStep === 2 && !this.validStep2()) return alert('Informe a data do sorteio.');
    if (this.wizardStep < 3) this.wizardStep++;
  },
  init() {
    if (new URLSearchParams(window.location.search).get('nova') === '1') {
      this.$nextTick(() => this.openWizard());
      const url = new URL(window.location.href);
      url.searchParams.delete('nova');
      history.replaceState({}, '', url.pathname + url.search);
    }
  }
}" @open-nova-rifa.window="openWizard()">

  <%- include('partials/nav', {
    active: 'rifas',
    pageTitle: 'Rifas',
    pageSubtitle: totalRifas ? totalRifas + ' sorteio' + (totalRifas !== 1 ? 's' : '') + ' cadastrado' + (totalRifas !== 1 ? 's' : '') : 'Gerencie seus sorteios',
    tenant,
    adminBase,
    tenantBase,
    adminUsuario,
    openModal: true
  }) %>

    <% if (msg) { %>
      <div class="admin-alert admin-alert-success">
        <i data-lucide="check-circle" class="w-4 h-4 shrink-0 mt-0.5"></i>
        <span><%= msg %></span>
      </div>
    <% } %>
    <% if (erro) { %>
      <div class="admin-alert admin-alert-error">
        <i data-lucide="alert-circle" class="w-4 h-4 shrink-0 mt-0.5"></i>
        <span><%= erro %></span>
      </div>
    <% } %>

    <%- include('partials/primeira-rifa-cta', {
      totalRifas,
      carteiraOk,
      adminBase
    }) %>

    <%- include('partials/rifas-lista') %>

  <%- include('partials/layout-end') %>

  <%- include('partials/nova-rifa-modal') %>

  <div id="qrcode-modal" class="fixed inset-0 z-[80] hidden items-center justify-center p-4" style="background:rgba(2,6,23,.65);backdrop-filter:blur(6px);" role="dialog" aria-modal="true" aria-labelledby="qrcode-modal-title">
    <div class="w-full max-w-[360px] relative">
      <button type="button" id="qrcode-modal-close" class="absolute -top-2 -right-2 z-10 w-9 h-9 rounded-full bg-white/10 text-white hover:bg-white/20 text-xl leading-none" aria-label="Fechar">×</button>
      <div id="qrcode-card" class="rounded-[28px] overflow-hidden shadow-2xl" style="background:#07111f;">
        <div class="px-6 pt-7 pb-6 flex flex-col items-center text-center">
          <p id="qrcode-card-url" class="text-[13px] font-medium tracking-wide mb-5 truncate max-w-full" style="color:#94a3b8;"></p>
          <div class="rounded-[22px] bg-white p-4 shadow-lg mb-5">
            <canvas id="qrcode-canvas" width="240" height="240" class="block"></canvas>
          </div>
          <p id="qrcode-card-premio" class="text-[15px] font-semibold leading-snug text-white px-2"></p>
        </div>
      </div>
      <canvas id="qrcode-export" width="720" height="900" class="hidden"></canvas>
      <div class="mt-4 flex flex-col gap-2">
        <button type="button" id="qrcode-download" class="admin-btn-primary w-full justify-center text-sm py-2.5">
          Baixar PNG
        </button>
        <button type="button" id="qrcode-copy-link" class="admin-action-btn w-full justify-center text-sm py-2.5 bg-white/95">
          Copiar link
        </button>
      </div>
    </div>
  </div>

  <script src="/js/qrcode.min.js"></script>
  <script>
    lucide.createIcons();

    function compartilharRifa(url, titulo) {
      var texto = (titulo ? titulo + ' — ' : '') + 'Participe do sorteio: ' + url;
      if (navigator.share) {
        navigator.share({ title: titulo || 'Sorteio', text: texto, url: url }).catch(function () {});
        return;
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(function () {
          alert('Link copiado!\n\n' + url);
        }).catch(function () { prompt('Copie o link:', url); });
      } else {
        prompt('Copie o link do sorteio:', url);
      }
    }

    document.querySelectorAll('.btn-share').forEach(function (btn) {
      btn.addEventListener('click', function () {
        compartilharRifa(btn.dataset.url, btn.dataset.titulo);
      });
    });

    (function () {
      var modal = document.getElementById('qrcode-modal');
      var canvas = document.getElementById('qrcode-canvas');
      var exportCv = document.getElementById('qrcode-export');
      var urlEl = document.getElementById('qrcode-card-url');
      var premioEl = document.getElementById('qrcode-card-premio');
      var currentUrl = '';
      var currentPremio = '';
      var currentLogo = '';
      var defaultLogo = <%- JSON.stringify((typeof tenant !== 'undefined' && tenant && tenant.logoUrl) ? tenant.logoUrl : '/img/pwa/icon-192.png') %>;
      var qrSize = 240;
      var qrColor = '#0f172a';

      function fecharQr() {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }

      function abrirQr() {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }

      function shortUrl(url) {
        try {
          var u = new URL(url);
          return (u.host + u.pathname).replace(/\/$/, '');
        } catch (_) {
          return String(url || '').replace(/^https?:\/\//, '').replace(/\/$/, '');
        }
      }

      function loadImage(src) {
        return new Promise(function (resolve) {
          if (!src) return resolve(null);
          var img = new Image();
          img.crossOrigin = 'anonymous';
          img.onload = function () { resolve(img); };
          img.onerror = function () { resolve(null); };
          img.src = src;
        });
      }

      function desenharLogoCircular(ctx, img, cx, cy, diameter) {
        if (!img) return;
        var r = diameter / 2;
        var pad = Math.round(r * 0.18);
        ctx.save();
        ctx.beginPath();
        ctx.arc(cx, cy, r + pad, 0, Math.PI * 2);
        ctx.fillStyle = '#ffffff';
        ctx.fill();
        ctx.beginPath();
        ctx.arc(cx, cy, r, 0, Math.PI * 2);
        ctx.clip();
        ctx.drawImage(img, cx - r, cy - r, diameter, diameter);
        ctx.restore();
      }

      function pintarQrNoCanvas(srcEl, logoImg) {
        var ctx = canvas.getContext('2d');
        ctx.clearRect(0, 0, qrSize, qrSize);
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, qrSize, qrSize);
        if (srcEl.tagName === 'CANVAS' || srcEl instanceof HTMLCanvasElement) {
          ctx.drawImage(srcEl, 0, 0, qrSize, qrSize);
        } else {
          ctx.drawImage(srcEl, 0, 0, qrSize, qrSize);
        }
        desenharLogoCircular(ctx, logoImg, qrSize / 2, qrSize / 2, Math.round(qrSize * 0.22));
      }

      function montarExport() {
        var W = 720, H = 900;
        exportCv.width = W;
        exportCv.height = H;
        var ctx = exportCv.getContext('2d');
        ctx.fillStyle = '#07111f';
        ctx.fillRect(0, 0, W, H);

        ctx.fillStyle = '#94a3b8';
        ctx.font = '500 28px Inter, system-ui, sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(shortUrl(currentUrl), W / 2, 90, W - 80);

        var box = 460;
        var boxX = (W - box) / 2;
        var boxY = 140;
        var radius = 36;
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.moveTo(boxX + radius, boxY);
        ctx.arcTo(boxX + box, boxY, boxX + box, boxY + box, radius);
        ctx.arcTo(boxX + box, boxY + box, boxX, boxY + box, radius);
        ctx.arcTo(boxX, boxY + box, boxX, boxY, radius);
        ctx.arcTo(boxX, boxY, boxX + box, boxY, radius);
        ctx.closePath();
        ctx.fill();

        var qrPad = 36;
        ctx.drawImage(canvas, boxX + qrPad, boxY + qrPad, box - qrPad * 2, box - qrPad * 2);

        ctx.fillStyle = '#ffffff';
        ctx.font = '600 32px Inter, system-ui, sans-serif';
        ctx.textAlign = 'center';
        var premio = currentPremio || 'Participe do sorteio';
        var maxW = W - 100;
        var words = String(premio).split(/\s+/);
        var lines = [];
        var line = '';
        words.forEach(function (w) {
          var test = line ? line + ' ' + w : w;
          if (ctx.measureText(test).width > maxW && line) {
            lines.push(line);
            line = w;
          } else {
            line = test;
          }
        });
        if (line) lines.push(line);
        var startY = boxY + box + 70;
        lines.slice(0, 3).forEach(function (ln, i) {
          ctx.fillText(ln, W / 2, startY + i * 42);
        });
      }

      function gerarViaLib(url) {
        var holder = document.createElement('div');
        holder.style.cssText = 'position:absolute;left:-9999px;top:0;';
        document.body.appendChild(holder);
        try {
          new QRCode(holder, {
            text: url,
            width: qrSize,
            height: qrSize,
            colorDark: qrColor,
            colorLight: '#ffffff',
            correctLevel: QRCode.CorrectLevel.H
          });
        } catch (e) {
          document.body.removeChild(holder);
          return Promise.reject(e);
        }
        return new Promise(function (resolve, reject) {
          var tries = 0;
          (function wait() {
            var el = holder.querySelector('canvas') || holder.querySelector('img');
            if (el && (el.tagName === 'CANVAS' || el.src)) {
              resolve(el);
              setTimeout(function () {
                try { document.body.removeChild(holder); } catch (_) {}
              }, 0);
              return;
            }
            if (++tries > 40) {
              try { document.body.removeChild(holder); } catch (_) {}
              reject(new Error('timeout'));
              return;
            }
            setTimeout(wait, 50);
          })();
        });
      }

      function gerarViaApi(url) {
        return new Promise(function (resolve, reject) {
          var img = new Image();
          img.crossOrigin = 'anonymous';
          img.onload = function () { resolve(img); };
          img.onerror = function () { reject(new Error('api')); };
          img.src = 'https://api.qrserver.com/v1/create-qr-code/?size=' + qrSize + 'x' + qrSize +
            '&margin=8&ecc=H&color=0f172a&bgcolor=ffffff&data=' + encodeURIComponent(url);
        });
      }

      function gerarQr(url, titulo, premio, logoUrl) {
        currentUrl = url;
        currentPremio = premio || titulo || 'Participe do sorteio';
        currentLogo = logoUrl || defaultLogo;
        urlEl.textContent = shortUrl(url);
        premioEl.textContent = currentPremio;

        var logoP = loadImage(currentLogo);
        var qrP = (typeof QRCode !== 'undefined')
          ? gerarViaLib(url)
          : Promise.reject(new Error('no-lib'));

        Promise.all([
          qrP.catch(function () { return gerarViaApi(url); }),
          logoP
        ]).then(function (parts) {
          pintarQrNoCanvas(parts[0], parts[1]);
          montarExport();
          abrirQr();
        }).catch(function () {
          alert('Não foi possível gerar o QR Code. Tente novamente.');
        });
      }

      document.querySelectorAll('.btn-qrcode').forEach(function (btn) {
        btn.addEventListener('click', function () {
          gerarQr(
            btn.dataset.url,
            btn.dataset.titulo,
            btn.dataset.premio,
            btn.dataset.logo || defaultLogo
          );
        });
      });

      document.getElementById('qrcode-modal-close').addEventListener('click', fecharQr);
      modal.addEventListener('click', function (e) {
        if (e.target === modal) fecharQr();
      });

      document.getElementById('qrcode-download').addEventListener('click', function () {
        montarExport();
        var a = document.createElement('a');
        a.href = exportCv.toDataURL('image/png');
        a.download = 'qrcode-sorteio.png';
        a.click();
      });

      document.getElementById('qrcode-copy-link').addEventListener('click', function () {
        if (!currentUrl) return;
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(currentUrl).then(function () {
            alert('Link copiado!');
          }).catch(function () { prompt('Copie o link:', currentUrl); });
        } else {
          prompt('Copie o link:', currentUrl);
        }
      });
    })();

    (function () {
      var id = new URLSearchParams(window.location.search).get('compartilhar');
      if (!id) return;
      var btn = document.querySelector('.btn-share[data-url*="/rifas/' + id + '"]');
      if (btn) {
        setTimeout(function () { compartilharRifa(btn.dataset.url, btn.dataset.titulo); }, 400);
      }
      var url = new URL(window.location.href);
      url.searchParams.delete('compartilhar');
      history.replaceState({}, '', url.pathname + url.search);
    })();
  </script>
</body>
</html>
