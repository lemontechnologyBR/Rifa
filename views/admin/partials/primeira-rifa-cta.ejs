<% if (typeof totalRifas !== 'undefined' && totalRifas === 0) {
  const carteiraPronta = typeof carteiraOk !== 'undefined' && carteiraOk;
%>
  <div class="admin-onboard mb-6">
    <div class="admin-onboard-icon">
      <i data-lucide="rocket" class="w-7 h-7"></i>
    </div>
    <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-1">Crie sua primeira rifa</h3>
    <p class="text-sm text-gray-600 dark:text-gray-400 max-w-md mx-auto">
      Monte o sorteio agora. A chave PIX na Carteira você configura depois — só é necessária para receber vendas.
    </p>
    <a href="<%= adminBase %>/rifas?nova=1" class="admin-btn-primary inline-flex items-center gap-2 px-6 py-3 text-sm mt-4">
      <i data-lucide="plus" class="w-4 h-4"></i> Criar minha primeira rifa
    </a>
    <div class="admin-onboard-steps">
      <a href="<%= adminBase %>/rifas?nova=1" class="admin-onboard-step admin-onboard-step--active">
        <span class="admin-onboard-step-num">1</span>
        <div>
          <p class="font-semibold text-sm">Crie o sorteio</p>
          <p class="text-xs text-gray-500 dark:text-gray-400">Nome, valor da cota e data</p>
        </div>
      </a>
      <a href="<%= adminBase %>/carteira" class="admin-onboard-step <%= carteiraPronta ? 'admin-onboard-step--done' : '' %>">
        <span class="admin-onboard-step-num"><% if (carteiraPronta) { %><i data-lucide="check" class="w-3 h-3"></i><% } else { %>2<% } %></span>
        <div>
          <p class="font-semibold text-sm">Configure o PIX</p>
          <p class="text-xs text-gray-500 dark:text-gray-400"><%= carteiraPronta ? 'PIX pronto' : 'Para receber os pagamentos' %></p>
        </div>
      </a>
      <div class="admin-onboard-step admin-onboard-step--muted">
        <span class="admin-onboard-step-num">3</span>
        <div>
          <p class="font-semibold text-sm">Compartilhe e venda</p>
          <p class="text-xs text-gray-500 dark:text-gray-400">WhatsApp, Instagram, link</p>
        </div>
      </div>
    </div>
  </div>
<% } else if (typeof carteiraOk !== 'undefined' && !carteiraOk) { %>
  <div class="admin-alert admin-alert-warning mb-6">
    <i data-lucide="wallet" class="w-4 h-4 shrink-0 mt-0.5"></i>
    <span>
      Seu sorteio está no ar, mas <strong>ainda não recebe PIX</strong>.
      <a href="<%= adminBase %>/carteira<%= typeof onboarding !== 'undefined' && onboarding ? '?onboarding=1' : '' %>" class="underline font-semibold">Configure a Carteira</a> para liberar as vendas.
    </span>
  </div>
<% } %>
