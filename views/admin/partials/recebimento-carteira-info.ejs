<div class="admin-panel-card p-4 text-sm space-y-2 <%= typeof compact !== 'undefined' && compact ? '!shadow-none border border-gray-100 dark:border-gray-800' : '' %>">
  <% if (tenant.pixChave) { %>
    <% const taxaFixa = typeof taxaFixaCota !== 'undefined' ? taxaFixaCota : (typeof wooviTaxaFixaCota !== 'undefined' ? wooviTaxaFixaCota : 0); %>
    <p class="font-semibold flex items-center gap-2"><i data-lucide="wallet" class="w-4 h-4 text-emerald-600"></i> Pagamentos automáticos</p>
    <p class="text-gray-500 dark:text-gray-400">PIX processado pela VouRifar — comissão de <strong class="text-gray-700 dark:text-gray-200">5%<% if (taxaFixa > 0) { %> + R$ <%= taxaFixa.toFixed(2).replace('.', ',') %>/cota<% } %></strong>. Você recebe o restante. Confirmação automática após o pagamento.</p>
    <p class="text-xs text-emerald-700 dark:text-emerald-400 font-medium">Chave: <%= tenant.pixChave %></p>
  <% } else { %>
    <p class="font-semibold flex items-center gap-2"><i data-lucide="wallet" class="w-4 h-4 text-emerald-600"></i> Recebimento</p>
    <p class="text-amber-700 dark:text-amber-400">
      Sem chave PIX as vendas ficam pausadas. Configure a
      <a href="<%= adminBase %>/carteira" class="underline font-medium">Carteira</a>
      para liberar o pagamento automático.
    </p>
  <% } %>
</div>
