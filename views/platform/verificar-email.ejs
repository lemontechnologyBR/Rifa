<%- include('../partials/header') %>

<div class="max-w-md mx-auto px-4 py-12">
  <div class="bg-white dark:bg-gray-800/80 rounded-2xl shadow-xl p-8 border border-gray-100 dark:border-gray-700/60 animate-fade-up">
    <div class="text-center mb-8">
      <div class="w-14 h-14 rounded-2xl btn-brand flex items-center justify-center mx-auto mb-4 shadow-lg">
        <i data-lucide="mail-check" class="w-7 h-7 text-white"></i>
      </div>
      <h1 class="text-2xl font-extrabold dark:text-white">Confirme seu e-mail</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">
        Enviamos um link de confirmação<% if (email) { %> para <strong class="text-gray-700 dark:text-gray-200"><%= email %></strong><% } %>.
        Abra o e-mail e clique no botão para ativar sua conta.
      </p>
    </div>

    <% if (msg) { %><div class="bg-green-50 dark:bg-green-900/30 text-green-700 dark:text-green-300 p-3 rounded-xl mb-4 text-sm border border-green-200 dark:border-green-800"><%= msg %></div><% } %>
    <% if (erro) { %><div class="bg-red-50 dark:bg-red-900/30 text-red-700 dark:text-red-300 p-3 rounded-xl mb-4 text-sm border border-red-200 dark:border-red-800"><%= erro %></div><% } %>

    <div class="bg-amber-50 dark:bg-amber-900/20 text-amber-800 dark:text-amber-200 p-3 rounded-xl mb-5 text-sm border border-amber-200 dark:border-amber-800">
      Não encontrou? Verifique a pasta de spam ou lixo eletrônico.
    </div>

    <form method="POST" action="/verificar-email/reenviar" class="space-y-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div>
        <label class="block text-xs font-semibold text-gray-500 uppercase mb-1.5">E-mail</label>
        <input type="email" name="email" required value="<%= email || '' %>" autocomplete="email" class="input-field" placeholder="seu@email.com">
      </div>
      <button type="submit" class="w-full btn-brand font-bold py-3.5 rounded-xl shadow-md">Reenviar confirmação</button>
    </form>

    <p class="mt-6 text-center text-sm text-gray-500">
      Já confirmou?
      <a href="/acessar" class="text-indigo-600 font-semibold hover:underline">Entrar no painel</a>
    </p>
  </div>
</div>

<%- include('../partials/footer') %>
