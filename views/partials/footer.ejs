  </main>

  <% const tb = (typeof tenant !== 'undefined' && tenant) ? '/' + tenant.slug : ''; %>
  <% const isPlatformLanding = typeof platformLanding !== 'undefined' && platformLanding; %>
  <% const legalCompany = 'LEMON TECHNOLOGY - SERVICOS DE TECNOLOGIA LTDA'; %>
  <% const legalCnpj = '67.816.117/0001-19'; %>

  <% const footerWa = (typeof rifaBrand !== 'undefined' && rifaBrand && rifaBrand.whatsapp)
    ? rifaBrand.whatsapp
    : ((typeof tenant !== 'undefined' && tenant) ? tenant.whatsapp : null); %>
  <% const footerIg = (typeof rifaBrand !== 'undefined' && rifaBrand && rifaBrand.instagram)
    ? rifaBrand.instagram
    : ((typeof tenant !== 'undefined' && tenant) ? tenant.instagram : null); %>
  <% const showTenantSocial = !isPlatformLanding && typeof tenant !== 'undefined' && tenant && (footerWa || footerIg); %>

  <footer class="mt-auto border-t border-gray-200/60 dark:border-gray-800/60 bg-white dark:bg-gray-900<%= isPlatformLanding ? ' platform-footer' : '' %>">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="public-footer">
        <div class="public-footer-brand">
          <%- include('vourifar-logo', { logoClass: 'h-8 sm:h-9 w-auto', logoTitle: platformName || 'VouRifar' }) %>
        </div>

        <div class="public-footer-disclaimer">
          <p>Tecnologia para organizadores de rifas. Cada sorteio é de responsabilidade exclusiva do organizador.</p>
          <p><%= legalCompany %> · CNPJ <%= legalCnpj %></p>
        </div>

        <div class="public-footer-meta">
          <p class="public-footer-copy">Criar seus sorteios? <a href="<%= tb ? '/' : '/cadastro' %>" class="public-footer-link">Começar grátis</a></p>
          <p class="public-footer-powered">
            <a href="/ajuda" class="public-footer-link">Central de Ajuda</a>
            · Powered by Lemon Technology🍋
          </p>
          <a href="<%= tb %>/politica-de-privacidade" class="public-footer-legal">Termos do participante</a>
        </div>
      </div>
    </div>
  </footer>

  <% if (showTenantSocial) { %>
  <nav class="public-social-float" aria-label="Redes sociais">
    <% if (footerWa) { %>
      <a href="https://wa.me/<%= footerWa %>" target="_blank" rel="noopener noreferrer" class="public-social-float-btn public-social-float-btn--wa" title="WhatsApp" aria-label="WhatsApp">
        <%- include('icon-whatsapp', { iconClass: 'w-5 h-5' }) %>
      </a>
    <% } %>
    <% if (footerIg) { %>
      <a href="https://instagram.com/<%= footerIg %>" target="_blank" rel="noopener noreferrer" class="public-social-float-btn public-social-float-btn--ig" title="@<%= footerIg %>" aria-label="Instagram @<%= footerIg %>">
        <%- include('icon-instagram', { iconClass: 'w-5 h-5', gradId: 'ig-gradient-float' }) %>
      </a>
    <% } %>
  </nav>
  <% } %>

  <% if (isPlatformLanding) { %>
  <%- include('chatwoot-widget') %>
  <% } %>

  <script src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js"></script>
  <script>
    (function () {
      window.__pendingScripts = window.__pendingScripts || [];
      window.loadAppScript = function (url) {
        return fetch(url, {
          credentials: 'same-origin',
          headers: { 'ngrok-skip-browser-warning': 'true', 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/javascript, text/javascript, */*' }
        }).then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.text(); })
          .then(function (code) {
            if (code.trim().charAt(0) === '<') throw new Error('JS bloqueado pelo ngrok');
            var s = document.createElement('script'); s.textContent = code; document.body.appendChild(s);
          });
      };
      var scripts = ['/js/input-masks.js', '/js/app.js'].concat(window.__pendingScripts);
      scripts.reduce(function (p, url) {
        return p.then(function () {
          return loadAppScript(url).catch(function (e) { console.error('[Scripts]', url, e.message); });
        });
      }, Promise.resolve())
        .then(function () {
          if (window.initInputMasks) window.initInputMasks();
          if (window.lucide) lucide.createIcons();
        })
        .catch(function (e) { console.error('[Scripts]', e.message); });
    })();
  </script>
</body>
</html>
