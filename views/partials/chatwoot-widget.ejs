<%
  const cwToken = typeof chatwootWebsiteToken !== 'undefined' ? String(chatwootWebsiteToken || '') : '';
  const cwBase = (typeof chatwootBaseUrl !== 'undefined' && chatwootBaseUrl)
    ? String(chatwootBaseUrl)
    : 'https://chat.vourifar.com.br';
%>
<% if (cwToken) { %>
<script>
  window.chatwootSettings = Object.assign({}, window.chatwootSettings || {}, {
    hideMessageBubble: false,
    position: 'right',
    locale: 'pt_BR',
    type: 'standard',
    launcherTitle: 'Fale conosco'
  });

  (function (d, t) {
    var BASE_URL = <%- JSON.stringify(cwBase) %>;
    var g = d.createElement(t), s = d.getElementsByTagName(t)[0];
    g.src = BASE_URL + '/packs/js/sdk.js';
    g.async = true;
    g.defer = true;
    s.parentNode.insertBefore(g, s);
    g.onload = function () {
      window.chatwootSDK.run({
        websiteToken: <%- JSON.stringify(cwToken) %>,
        baseUrl: BASE_URL
      });
    };
  })(document, 'script');

  window.vourifarOpenSupport = function () {
    function openBubble() {
      if (window.$chatwoot && typeof window.$chatwoot.toggle === 'function') {
        window.$chatwoot.toggle('open');
        return true;
      }
      return false;
    }
    if (openBubble()) return false;
    var tries = 0;
    var timer = setInterval(function () {
      tries += 1;
      if (openBubble() || tries > 20) clearInterval(timer);
    }, 250);
    return false;
  };
</script>
<% } else { %>
<script>
  window.vourifarOpenSupport = function () {
    window.open(<%- JSON.stringify(cwBase) %>, '_blank', 'noopener');
    return false;
  };
</script>
<% } %>
