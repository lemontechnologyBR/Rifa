# Chatwoot — copie para .env na VPS (/docker/chatwoot/.env)
# Gere SECRET_KEY_BASE: openssl rand -hex 64

SECRET_KEY_BASE=
FRONTEND_URL=https://chat.vourifar.com.br
FORCE_SSL=true
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
ENABLE_ACCOUNT_SIGNUP=false
DEFAULT_LOCALE=pt_BR

POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=chatwoot

REDIS_URL=redis://:ALTERE_REDIS_PASSWORD@redis:6379
REDIS_PASSWORD=ALTERE_REDIS_PASSWORD

MAILER_SENDER_EMAIL=VouRifar <noreply@vourifar.com.br>
SMTP_DOMAIN=vourifar.com.br
SMTP_ADDRESS=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=noreply@vourifar.com.br
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=false
SMTP_SSL=true
SMTP_OPENSSL_VERIFY_MODE=peer

ACTIVE_STORAGE_SERVICE=local
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
